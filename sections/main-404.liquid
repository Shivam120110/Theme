<!-- 404 Page Section -->
<div class="not-found">
  <div class="not-found__inner container">
    <p class="not-found__label">404</p>
    <h1 class="not-found__heading">This page has moved on.</h1>
    <p class="not-found__body">
      The piece you're looking for may have sold out, moved, or never existed here.<br>
      Let us guide you back to something beautiful.
    </p>
    <a href="{{ routes.root_url }}" class="btn btn--primary">Return Home</a>
    <a href="{{ routes.collections_url }}" class="btn btn--outline" style="margin-left: 1rem;">Browse Collections</a>
  </div>
</div>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-16) var(--grid-gutter);
  }

  .not-found__label {
    font-family: var(--font-display);
    font-size: 8rem;
    font-weight: 300;
    color: var(--color-surface);
    line-height: 1;
    margin-bottom: var(--space-4);
    letter-spacing: 0.1em;
  }

  .not-found__heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 400;
    margin-bottom: var(--space-4);
  }

  .not-found__body {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.8;
    max-width: 480px;
    margin: 0 auto var(--space-8);
  }
</style>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
