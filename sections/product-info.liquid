{% comment %}
  Section: product-info.liquid
  Purpose: Product page right panel — title, price, variant selectors,
           quantity stepper, add-to-bag, trust signals, accordions, share.
  Brand: Saanjh — considered, editorial, never pushy.
{% endcomment %}

<link rel="stylesheet" href="{{ 'product.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'product.css' | asset_url }}"></noscript>

{%- assign current_variant  = product.selected_or_first_available_variant -%}
{%- assign styling_notes    = product.metafields.custom.styling_notes.value -%}
{%- assign product_material = product.metafields.custom.material.value -%}
{%- assign product_weight   = product.metafields.custom.weight.value -%}
{%- assign product_dims     = product.metafields.custom.dimensions.value -%}

<div
  class="product-info"
  id="ProductInfo"
  data-product-info
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
>

  {%- comment -%} ── Breadcrumb / Collection Backlink ── {%- endcomment -%}
  <nav class="product-info__breadcrumb" aria-label="Breadcrumb">
    <ol class="breadcrumb" role="list">
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="/">Home</a>
      </li>
      {% if collection %}
        <li class="breadcrumb__item" aria-hidden="true">
          <span class="breadcrumb__sep">{% render 'icon-chevron-right' %}</span>
        </li>
        <li class="breadcrumb__item">
          <a class="breadcrumb__link" href="{{ collection.url }}">{{ collection.title }}</a>
        </li>
      {% endif %}
      <li class="breadcrumb__item" aria-hidden="true">
        <span class="breadcrumb__sep">{% render 'icon-chevron-right' %}</span>
      </li>
      <li class="breadcrumb__item" aria-current="page">
        {{ product.title }}
      </li>
    </ol>
  </nav>

  {%- comment -%} ── Product Title ── {%- endcomment -%}
  <h1 class="product-info__title" itemprop="name">{{ product.title }}</h1>

  {%- comment -%} ── Price Block ── {%- endcomment -%}
  <div
    class="product-info__price-wrap"
    id="PriceBlock"
    data-price-block
    itemprop="offers"
    itemscope
    itemtype="https://schema.org/Offer"
  >
    <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
    <meta itemprop="availability" content="{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}">

    <span
      class="product-info__price{% if current_variant.compare_at_price > current_variant.price %} product-info__price--on-sale{% endif %}"
      data-product-price
      itemprop="price"
      content="{{ current_variant.price | divided_by: 100.0 }}"
    >
      {{ current_variant.price | money }}
    </span>

    {% if current_variant.compare_at_price > current_variant.price %}
      <span class="product-info__compare-price" data-compare-price>
        <s>{{ current_variant.compare_at_price | money }}</s>
        <span class="visually-hidden">Regular price</span>
      </span>
      <span class="product-info__badge">
        Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}%
      </span>
    {% else %}
      <span class="product-info__compare-price product-info__compare-price--hidden" data-compare-price aria-hidden="true"></span>
    {% endif %}

  </div>

  {%- comment -%} ── Trust Signals (near price) ── {%- endcomment -%}
  {% if section.settings.show_trust_signals %}
    <ul class="trust-signals" role="list" aria-label="Trust signals">
      {% if section.settings.trust_signal_1 != blank %}
        <li class="trust-signals__item">
          {% render 'icon-shield-check' %}
          <span>{{ section.settings.trust_signal_1 }}</span>
        </li>
      {% endif %}
      {% if section.settings.trust_signal_2 != blank %}
        <li class="trust-signals__item">
          {% render 'icon-truck' %}
          <span>{{ section.settings.trust_signal_2 }}</span>
        </li>
      {% endif %}
      {% if section.settings.trust_signal_3 != blank %}
        <li class="trust-signals__item">
          {% render 'icon-refresh-ccw' %}
          <span>{{ section.settings.trust_signal_3 }}</span>
        </li>
      {% endif %}
    </ul>
  {% endif %}

  {%- comment -%} ── Product Form ── {%- endcomment -%}
  {% form 'product', product, id: 'ProductForm', data-product-form: '', novalidate: 'novalidate' %}

    {%- comment -%} Hidden variant ID input {%- endcomment -%}
    <input
      type="hidden"
      name="id"
      id="VariantId"
      value="{{ current_variant.id }}"
      data-variant-id
    >

    {%- comment -%} ── Variant Selectors ── {%- endcomment -%}
    {% unless product.has_only_default_variant %}
      <div class="product-variants" data-product-variants>

        {% for option in product.options_with_values %}
          <fieldset
            class="variant-group"
            id="VariantGroup-{{ option.position }}"
            data-variant-group="{{ option.position }}"
          >
            <legend class="variant-group__legend">
              {{ option.name }}:
              <span class="variant-group__selected" data-option-selected="{{ option.position }}">
                {{ option.selected_value }}
              </span>
            </legend>

            <div class="variant-group__options">
              {%- assign option_name_lower = option.name | downcase -%}

              {% for value in option.values %}
                {%- comment -%} Determine swatch type vs pill {%- endcomment -%}
                {%- assign is_metal  = false -%}
                {%- assign is_stone  = false -%}
                {%- if option_name_lower == 'metal' or option_name_lower == 'metal type' -%}
                  {%- assign is_metal = true -%}
                {%- endif -%}
                {%- if option_name_lower == 'stone' or option_name_lower == 'gemstone' -%}
                  {%- assign is_stone = true -%}
                {%- endif -%}

                {%- assign is_selected = false -%}
                {%- if option.selected_value == value -%}
                  {%- assign is_selected = true -%}
                {%- endif -%}

                <label
                  class="variant-option{% if is_metal %} variant-option--metal{% elsif is_stone %} variant-option--stone{% else %} variant-option--pill{% endif %}{% if is_selected %} variant-option--selected{% endif %}"
                  data-option-label
                  data-option-position="{{ option.position }}"
                  data-option-value="{{ value | escape }}"
                >
                  <input
                    type="radio"
                    class="variant-option__input visually-hidden"
                    name="options[{{ option.name | escape }}]"
                    value="{{ value | escape }}"
                    {% if is_selected %}checked{% endif %}
                    data-option-input
                    data-option-position="{{ option.position }}"
                  >

                  {% if is_metal %}
                    {%- assign value_lower = value | downcase -%}
                    {%- if value_lower == 'rose gold' -%}
                      <span class="variant-swatch variant-swatch--rose-gold" aria-hidden="true"></span>
                    {%- elsif value_lower == 'yellow gold' -%}
                      <span class="variant-swatch variant-swatch--yellow-gold" aria-hidden="true"></span>
                    {%- elsif value_lower == 'white gold' -%}
                      <span class="variant-swatch variant-swatch--white-gold" aria-hidden="true"></span>
                    {%- elsif value_lower == 'silver' -%}
                      <span class="variant-swatch variant-swatch--silver" aria-hidden="true"></span>
                    {%- else -%}
                      <span class="variant-swatch variant-swatch--default" aria-hidden="true"></span>
                    {%- endif -%}
                  {% elsif is_stone %}
                    <span class="variant-stone" aria-hidden="true">◇</span>
                  {% endif %}

                  <span class="variant-option__label">{{ value }}</span>
                </label>

              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}

      </div>
    {% endunless %}

    {%- comment -%} ── Quantity Stepper ── {%- endcomment -%}
    <div class="product-quantity" data-quantity-wrapper>
      <label class="product-quantity__label" for="Quantity">Quantity</label>
      <div class="product-quantity__stepper" role="group" aria-label="Adjust quantity">
        <button
          class="product-quantity__btn product-quantity__btn--minus"
          type="button"
          aria-label="Decrease quantity"
          data-qty-minus
        >
          {% render 'icon-minus' %}
        </button>
        <input
          id="Quantity"
          class="product-quantity__input"
          type="number"
          name="quantity"
          value="1"
          min="1"
          max="{{ current_variant.inventory_quantity | default: 99 }}"
          aria-label="Product quantity"
          data-qty-input
        >
        <button
          class="product-quantity__btn product-quantity__btn--plus"
          type="button"
          aria-label="Increase quantity"
          data-qty-plus
        >
          {% render 'icon-plus' %}
        </button>
      </div>
    </div>

    {%- comment -%} ── Add to Bag + Availability ── {%- endcomment -%}
    <div class="product-actions">
      <button
        id="AddToBagBtn"
        class="btn-add-to-bag"
        type="submit"
        name="add"
        data-add-to-cart
        {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
      >
        <span class="btn-add-to-bag__text" data-add-to-cart-text>
          {% if current_variant.available %}
            Add to Bag
          {% else %}
            Unavailable
          {% endif %}
        </span>
        <span class="btn-add-to-bag__loader" aria-hidden="true" data-cart-loader>
          {% render 'icon-loader' %}
        </span>
      </button>

      {%- comment -%} Cart feedback message {%- endcomment -%}
      <div
        class="product-actions__feedback"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-cart-feedback
      ></div>
    </div>

  {% endform %}

  {%- comment -%} ── Accordions ── {%- endcomment -%}
  <div class="product-accordions" data-accordions>

    {%- comment -%} Styling Notes accordion {%- endcomment -%}
    {% if section.settings.show_styling_notes and styling_notes != blank %}
      <details class="product-accordion" data-accordion>
        <summary class="product-accordion__summary">
          <span class="product-accordion__title">Styling Notes</span>
          <span class="product-accordion__icon" aria-hidden="true">
            {% render 'icon-chevron-down' %}
          </span>
        </summary>
        <div class="product-accordion__body">
          <div class="product-accordion__content product-accordion__content--editorial">
            {{ styling_notes }}
          </div>
        </div>
      </details>
    {% endif %}

    {%- comment -%} Product Details accordion {%- endcomment -%}
    <details class="product-accordion" data-accordion>
      <summary class="product-accordion__summary">
        <span class="product-accordion__title">Product Details</span>
        <span class="product-accordion__icon" aria-hidden="true">
          {% render 'icon-chevron-down' %}
        </span>
      </summary>
      <div class="product-accordion__body">
        <dl class="product-details-list">
          {% if product_material != blank %}
            <div class="product-details-list__row">
              <dt class="product-details-list__term">Material</dt>
              <dd class="product-details-list__desc">{{ product_material }}</dd>
            </div>
          {% endif %}
          {% if product_weight != blank %}
            <div class="product-details-list__row">
              <dt class="product-details-list__term">Weight</dt>
              <dd class="product-details-list__desc">{{ product_weight }}</dd>
            </div>
          {% endif %}
          {% if product_dims != blank %}
            <div class="product-details-list__row">
              <dt class="product-details-list__term">Dimensions</dt>
              <dd class="product-details-list__desc">{{ product_dims }}</dd>
            </div>
          {% endif %}
          {% if product_material == blank and product_weight == blank and product_dims == blank %}
            <div class="product-accordion__content">
              {{ product.description }}
            </div>
          {% endif %}
        </dl>
      </div>
    </details>

    {%- comment -%} Care & Handling accordion {%- endcomment -%}
    <details class="product-accordion" data-accordion>
      <summary class="product-accordion__summary">
        <span class="product-accordion__title">Care & Handling</span>
        <span class="product-accordion__icon" aria-hidden="true">
          {% render 'icon-chevron-down' %}
        </span>
      </summary>
      <div class="product-accordion__body">
        <div class="product-accordion__content">
          {%- assign care_notes = product.metafields.custom.care_notes.value -%}
          {% if care_notes != blank %}
            {{ care_notes }}
          {% else %}
            <p>Store in the soft pouch provided. Avoid contact with perfumes and moisture. Wipe gently with a dry cloth after wear.</p>
          {% endif %}
        </div>
      </div>
    </details>

  </div>

  {%- comment -%} ── Share Links ── {%- endcomment -%}
  <div class="product-share" aria-label="Share this product">
    <span class="product-share__label">Share:</span>
    <ul class="product-share__links" role="list">
      <li>
        <a
          class="product-share__link"
          href="https://api.whatsapp.com/send?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on WhatsApp"
        >
          {% render 'icon-whatsapp' %}
        </a>
      </li>
      <li>
        <a
          class="product-share__link"
          href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Facebook"
        >
          {% render 'icon-facebook' %}
        </a>
      </li>
      <li>
        <a
          class="product-share__link"
          href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_image | image_url: width: 800 }}&description={{ product.title | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on Pinterest"
        >
          {% render 'icon-pinterest' %}
        </a>
      </li>
      <li>
        <button
          class="product-share__link product-share__link--copy"
          type="button"
          data-copy-link
          data-url="{{ shop.url }}{{ product.url }}"
          aria-label="Copy product link"
        >
          {% render 'icon-link' %}
        </button>
      </li>
    </ul>
  </div>

  {%- comment -%} Product JSON for JS variant switching {%- endcomment -%}
  <script type="application/json" id="ProductJSON" data-product-json>
    {{ product | json }}
  </script>

</div>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product Info",
  "tag": "div",
  "class": "product-info-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_trust_signals",
      "label": "Show trust signals",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_signal_1",
      "label": "Trust signal 1",
      "default": "BIS Hallmark certified"
    },
    {
      "type": "text",
      "id": "trust_signal_2",
      "label": "Trust signal 2",
      "default": "Free shipping over ₹5,000"
    },
    {
      "type": "text",
      "id": "trust_signal_3",
      "label": "Trust signal 3",
      "default": "Easy 15-day returns"
    },
    {
      "type": "checkbox",
      "id": "show_styling_notes",
      "label": "Show Styling Notes accordion",
      "default": true,
      "info": "Reads from product metafield: custom.styling_notes"
    }
  ],
  "presets": [
    {
      "name": "Product Info"
    }
  ]
}
{% endschema %}
