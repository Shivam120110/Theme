<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F7F4EF">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Canonical & hreflang -->
  <link rel="canonical" href="{{ canonical_url }}">
  {% if settings.enable_open_graph %}
    {{ content_for_header }}
  {% else %}
    {{ content_for_header }}
  {% endif %}

  <!-- Favicon -->
  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {% endif %}

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Google Fonts: Cormorant Garamond + Poppins -->
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <!-- Design Tokens injected from theme settings -->
  <style>
    :root {
      --color-bg: {{ settings.color_background | default: '#F7F4EF' }};
      --color-ink: {{ settings.color_ink | default: '#1C1B1A' }};
      --color-accent: {{ settings.color_accent | default: '#B08A5A' }};
      --color-surface: {{ settings.color_surface | default: '#EFEBE3' }};
      --color-muted: {{ settings.color_muted | default: '#8A8680' }};
      --color-cta: {{ settings.color_cta | default: '#8B2635' }};
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'Poppins', system-ui, -apple-system, sans-serif;
    }
  </style>

  <!-- Global Styles -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Header Styles -->
  {{ 'header.css' | asset_url | stylesheet_tag }}

  <!-- Collection Styles -->
  {{ 'collection.css' | asset_url | stylesheet_tag }}

  <!-- Product Styles -->
  {{ 'product.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-{{ template.name | handle }} {% if settings.sticky_header %}has-sticky-header{% endif %}">

  <!-- Skip to main content (Accessibility) -->
  <a class="skip-to-content" href="#main-content">Skip to content</a>

  <!-- Announcement Bar (if enabled) -->
  {% if settings.enable_announcement_bar %}
    {% section 'announcement-bar' %}
  {% endif %}

  <!-- Site Header -->
  {% section 'header' %}

  <!-- Main Content -->
  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Site Footer -->
  {% section 'footer' %}

  <!-- Overlay for mobile drawer -->
  <div class="site-overlay" id="site-overlay" aria-hidden="true"></div>

  <!-- JavaScript -->
  <script src="{{ 'header.js' | asset_url }}" defer></script>
  <script src="{{ 'collection.js' | asset_url }}" defer></script>
  <script src="{{ 'product.js' | asset_url }}" defer></script>

</body>
</html>
