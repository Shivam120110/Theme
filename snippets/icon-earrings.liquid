<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <!--
    Earring icon: classic hook-and-drop silhouette
    - Shepherd's hook curve at top (the ear wire)
    - Thin connector stem
    - Teardrop gem hanging below
  -->

  <!-- Shepherd's hook: starts at upper-right, curves over and down into stem -->
  <!-- Hook arc: from top-right, loops left/up, then comes back down -->
  <path d="M14,4 C14,2.5 12.5,2 11.5,2 C9.5,2 8,3.5 8,5.5 C8,7 8.8,8 10,8.5" />

  <!-- Thin drop stem connecting hook to gem -->
  <line x1="10" y1="8.5" x2="12" y2="13" />

  <!-- Teardrop gem: pointed at bottom, rounded top -->
  <path d="M12,13 C9.5,13 8,15 8,17 C8,19.2 9.8,21 12,21 C14.2,21 16,19.2 16,17 C16,15 14.5,13 12,13 Z" />

  <!-- Inner facet line on the teardrop for jewel detail -->
  <line x1="12" y1="14.5" x2="12" y2="19" />
</svg>
