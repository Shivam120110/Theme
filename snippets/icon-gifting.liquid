<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <!--
    Gifting icon: ribbon-tied gift box
    - Rectangle box body
    - Horizontal ribbon band across the middle of the box
    - Vertical ribbon band down the centre of the box
    - Bow at top: two rounded loops + two short tails
  -->

  <!-- Gift box body -->
  <rect x="3" y="10" width="18" height="12" rx="1" />

  <!-- Lid / top band of box -->
  <rect x="3" y="8" width="18" height="3" rx="1" />

  <!-- Vertical ribbon stripe down centre of box -->
  <line x1="12" y1="8" x2="12" y2="22" />

  <!-- Horizontal ribbon stripe across box body (mid of the lid) -->
  <!-- (The rect border at y=8–11 already gives the horizontal band; the vertical line cuts through it) -->

  <!-- Bow left loop: curves up-left from centre top -->
  <path d="M12,8 C11,5 7,4 7,6.5 C7,8.5 10,8.5 12,8" />

  <!-- Bow right loop: curves up-right from centre top -->
  <path d="M12,8 C13,5 17,4 17,6.5 C17,8.5 14,8.5 12,8" />

  <!-- Bow left tail: short ribbon tail dropping left from knot -->
  <path d="M12,8 C10.5,9 9,9.5 8,10" />

  <!-- Bow right tail: short ribbon tail dropping right from knot -->
  <path d="M12,8 C13.5,9 15,9.5 16,10" />
</svg>
