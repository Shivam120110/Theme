<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <!--
    Gem icon: octagonal crown outline with inner facet lines
    Outer shape: 8-sided gem silhouette (cut gemstone, front view)
    Inner lines: table facets radiating from a central flat top
  -->

  <!-- Outer octagon gem outline (flat top and bottom, angled sides) -->
  <polygon points="8,3 16,3 21,8 21,16 16,21 8,21 3,16 3,8" />

  <!-- Gem table (inner flat facet at the crown top) -->
  <line x1="8" y1="3" x2="6" y2="9" />
  <line x1="16" y1="3" x2="18" y2="9" />
  <line x1="21" y1="8" x2="18" y2="9" />
  <line x1="21" y1="16" x2="18" y2="15" />
  <line x1="16" y1="21" x2="14" y2="15" />
  <line x1="8" y1="21" x2="10" y2="15" />
  <line x1="3" y1="16" x2="6" y2="15" />
  <line x1="3" y1="8" x2="6" y2="9" />

  <!-- Inner girdle / table outline connecting the facet break points -->
  <polygon points="6,9 18,9 18,15 14,15 12,17 10,15 6,15" />

  <!-- Central culet line: apex of the crown pointing down to girdle center -->
  <line x1="12" y1="3" x2="12" y2="9" />
</svg>
