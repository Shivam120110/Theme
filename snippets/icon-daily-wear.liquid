<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <!--
    Daily wear icon: elegant lemniscate (infinity / figure-8)
    Rendered as two smooth looping circles joined at the centre,
    drawn as a single continuous cubic-Bezier path for an
    organic, hand-drawn feel. Suggests continuity and everyday elegance.
  -->

  <!--
    Lemniscate path:
    Start at centre (12,12), sweep left loop, return to centre,
    sweep right loop, close back at centre.
    Control-point tuning keeps both lobes symmetrical and gives
    the crossing point a natural overlap feel.
  -->
  <path d="
    M12,12
    C12,9.5 9,7 6.5,7
    C4,7 2,8.8 2,12
    C2,15.2 4,17 6.5,17
    C9,17 12,14.5 12,12
    C12,9.5 15,7 17.5,7
    C20,7 22,8.8 22,12
    C22,15.2 20,17 17.5,17
    C15,17 12,14.5 12,12
    Z
  " />
</svg>
