{%- comment -%}
  ============================================================
  Snippet: icon-social.liquid
  Usage:   {% render 'icon-social', icon: 'instagram' %}

  Parameters
  ----------
  icon  {String}  Required. One of:
                  'instagram' | 'facebook' | 'pinterest' |
                  'twitter' | 'youtube'

  All icons:
  - viewBox 0 0 24 24
  - fill none
  - stroke currentColor, stroke-width 1.5
  - stroke-linecap round, stroke-linejoin round
  - aria-hidden true (callers supply accessible labels)
  ============================================================
{%- endcomment -%}

{%- case icon -%}

  {%- when 'instagram' -%}
    {%- comment %} Instagram: rounded square camera body + lens circle + top-right dot {%- endcomment %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <!-- Outer rounded-rectangle body -->
      <rect x="2" y="2" width="20" height="20" rx="5" />
      <!-- Lens circle -->
      <circle cx="12" cy="12" r="4" />
      <!-- Flash / indicator dot top-right -->
      <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none" />
    </svg>

  {%- when 'facebook' -%}
    {%- comment %} Facebook: circle with stylised 'f' letterform {%- endcomment %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <!-- Outer circle -->
      <circle cx="12" cy="12" r="10" />
      <!-- Vertical stem of f -->
      <line x1="13" y1="8.5" x2="13" y2="21" />
      <!-- Cross-bar of f -->
      <line x1="10" y1="13" x2="16" y2="13" />
      <!-- Top curve of f (rounds over to the right) -->
      <path d="M13,8.5 C13,7 14,6 15.5,6" />
    </svg>

  {%- when 'pinterest' -%}
    {%- comment %} Pinterest: circle with 'P' and downward pin-drop tail {%- endcomment %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <!-- Outer circle -->
      <circle cx="12" cy="12" r="10" />
      <!--
        Pinterest P letterform:
        - Vertical stem (enters from top, exits as pin tail)
        - Bowl curving right from mid-stem
      -->
      <!-- Stem: enters at top, goes past midpoint, then drops as pin tail to bottom -->
      <path d="M10,7 L10,20" />
      <!-- Bowl of P: from upper-stem, sweeps right then back to mid-stem -->
      <path d="M10,7 C10,7 15,6.5 15,10 C15,13 10,13 10,13" />
      <!-- Pin tail angling down-right from the bottom of the bowl area -->
      <path d="M10,14 C10,14 9,17 8,19" />
    </svg>

  {%- when 'twitter' -%}
    {%- comment -%}
      Twitter / X: the modern X wordmark.
      Two diagonal strokes crossing at centre, with short serifs at each end.
    {%- endcomment -%}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <!-- X stroke 1: top-left to bottom-right -->
      <line x1="4" y1="4" x2="20" y2="20" />
      <!-- X stroke 2: top-right to bottom-left -->
      <line x1="20" y1="4" x2="4" y2="20" />
    </svg>

  {%- when 'youtube' -%}
    {%- comment %} YouTube: rounded rectangle with centred play triangle {%- endcomment %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <!-- Rounded rectangle (screen) -->
      <rect x="2" y="5" width="20" height="14" rx="4" />
      <!-- Play triangle: left-pointing vertex at 9,9, tip at 16,12, back to 9,15 -->
      <polygon points="10,9 16,12 10,15" />
    </svg>

  {%- else -%}
    {%- comment %} Fallback: generic link / share icon if icon name is unrecognised {%- endcomment %}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="18" cy="5" r="2" />
      <circle cx="6" cy="12" r="2" />
      <circle cx="18" cy="19" r="2" />
      <line x1="8" y1="11" x2="16" y2="6" />
      <line x1="8" y1="13" x2="16" y2="18" />
    </svg>

{%- endcase -%}
