{% comment %}
  Renders a small inline SVG based on the `icon` parameter.
  Usage: {% render 'icon-ui', icon: 'chevron-down' %}
  Supported icons: chevron-down, chevron-right, arrow-left, arrow-right,
  filter, zoom-in, shield-check, truck, refresh-ccw, minus, plus, loader,
  whatsapp, facebook, pinterest, link, sparkle, rotate-3d, x, x-small,
  image-placeholder
{% endcomment %}

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
  stroke-linejoin="round" aria-hidden="true" focusable="false">

  {%- case icon -%}

    {%- when 'chevron-down' -%}
      <polyline points="6 9 12 15 18 9"/>

    {%- when 'chevron-right' -%}
      <polyline points="9 18 15 12 9 6"/>

    {%- when 'arrow-left' -%}
      <line x1="19" y1="12" x2="5" y2="12"/>
      <polyline points="12 19 5 12 12 5"/>

    {%- when 'arrow-right' -%}
      <line x1="5" y1="12" x2="19" y2="12"/>
      <polyline points="12 5 19 12 12 19"/>

    {%- when 'filter' -%}
      <line x1="4" y1="6" x2="20" y2="6"/>
      <line x1="8" y1="12" x2="16" y2="12"/>
      <line x1="11" y1="18" x2="13" y2="18"/>

    {%- when 'zoom-in' -%}
      <circle cx="11" cy="11" r="7"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      <line x1="11" y1="8" x2="11" y2="14"/>
      <line x1="8" y1="11" x2="14" y2="11"/>

    {%- when 'shield-check' -%}
      <path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.25C18.25 22.15 22 17.25 22 12V7L12 2z"/>
      <polyline points="9 12 11 14 15 10"/>

    {%- when 'truck' -%}
      <rect x="1" y="3" width="15" height="13" rx="1"/>
      <path d="M16 8h4l3 5v4h-7V8z"/>
      <circle cx="5.5" cy="18.5" r="2.5"/>
      <circle cx="18.5" cy="18.5" r="2.5"/>

    {%- when 'refresh-ccw' -%}
      <polyline points="1 4 1 10 7 10"/>
      <polyline points="23 20 23 14 17 14"/>
      <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>

    {%- when 'minus' -%}
      <line x1="5" y1="12" x2="19" y2="12"/>

    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"/>
      <line x1="5" y1="12" x2="19" y2="12"/>

    {%- when 'loader' -%}
      <line x1="12" y1="2" x2="12" y2="6"/>
      <line x1="12" y1="18" x2="12" y2="22"/>
      <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
      <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
      <line x1="2" y1="12" x2="6" y2="12"/>
      <line x1="18" y1="12" x2="22" y2="12"/>
      <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/>
      <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>

    {%- when 'whatsapp' -%}
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>

    {%- when 'facebook' -%}
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>

    {%- when 'pinterest' -%}
      <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.04-2.83.18-.75 1.23-5.22 1.23-5.22s-.31-.63-.31-1.57c0-1.47.85-2.57 1.91-2.57.9 0 1.34.68 1.34 1.49 0 .91-.58 2.27-.88 3.53-.25 1.05.52 1.9 1.55 1.9 1.86 0 3.3-1.96 3.3-4.8 0-2.51-1.81-4.26-4.39-4.26-2.99 0-4.74 2.24-4.74 4.56 0 .9.35 1.87.78 2.39.09.11.1.2.07.32-.08.32-.25 1.05-.29 1.19-.04.18-.14.22-.33.13-1.25-.58-2.03-2.42-2.03-3.89 0-3.16 2.3-6.07 6.63-6.07 3.48 0 6.19 2.48 6.19 5.8 0 3.46-2.18 6.24-5.2 6.24-1.02 0-1.97-.53-2.3-1.15l-.62 2.33c-.23.87-.84 1.96-1.25 2.62.94.29 1.94.45 2.97.45 5.52 0 10-4.48 10-10S17.52 2 12 2z"/>

    {%- when 'link' -%}
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>

    {%- when 'sparkle' -%}
      <path d="M12 2l2.4 7.2H22l-6.2 4.5 2.4 7.3L12 16.5 5.8 21 8.2 13.7 2 9.2h7.6z"/>

    {%- when 'rotate-3d' -%}
      <path d="M16.466 7.5C15.643 4.237 13.952 2 12 2 9.239 2 7 6.477 7 12s2.239 10 5 10c.342 0 .677-.069 1-.2"/>
      <path d="M15 21.7c3.5-1.2 6-5.7 6-10.7 0-2.41-.5-4.66-1.38-6.49"/>
      <path d="M9 3.3C5.5 4.5 3 9 3 14c0 2.41.5 4.66 1.38 6.49"/>
      <line x1="7" y1="12" x2="17" y2="12"/>

    {%- when 'x' -%}
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>

    {%- when 'x-small' -%}
      <line x1="15" y1="9" x2="9" y2="15"/>
      <line x1="9" y1="9" x2="15" y2="15"/>

    {%- when 'image-placeholder' -%}
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
      <circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>

    {%- else -%}
      <!-- Fallback: small diamond -->
      <polygon points="12,3 20,12 12,21 4,12"/>

  {%- endcase -%}

</svg>
