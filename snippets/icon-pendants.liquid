<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <!--
    Pendant icon: necklace arc with hanging gem
    - Wide curved arc at top = the chain draping over the neckline
    - Small bail loop where the pendant connects to the chain
    - Faceted teardrop gem hanging below
  -->

  <!-- Necklace chain arc (wide drape, two ends falling to mid-sides) -->
  <path d="M3,5 Q12,13 21,5" />

  <!-- Left and right chain tails going off-frame (suggesting the chain continues around) -->
  <line x1="3" y1="5" x2="3" y2="7" />
  <line x1="21" y1="5" x2="21" y2="7" />

  <!-- Bail (small loop at top of pendant connecting to chain) -->
  <ellipse cx="12" cy="13" rx="1.5" ry="1.2" />

  <!-- Short connector from bail to gem -->
  <line x1="12" y1="14.2" x2="12" y2="15" />

  <!-- Teardrop pendant gem -->
  <path d="M12,15 C9.8,15 8.5,16.8 8.5,18.5 C8.5,20.4 10.1,22 12,22 C13.9,22 15.5,20.4 15.5,18.5 C15.5,16.8 14.2,15 12,15 Z" />

  <!-- Inner gem facet for detail -->
  <line x1="12" y1="16.2" x2="12" y2="20.5" />
  <line x1="10.2" y1="17.5" x2="13.8" y2="17.5" />
</svg>
